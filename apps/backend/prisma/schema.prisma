// apps/backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ContractStatus {
  DRAFT
  SIGNED
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id
  createdAt DateTime @default(now())

  bankId    String @unique
  firstName String
  lastName  String
  phone     String

  // Aggregates
  rating      Float @default(0)
  ratingCount Int   @default(0)

  bankIdVerified   Boolean   @default(false)
  bankIdVerifiedAt DateTime?

  passwordHash String?

  favorites Favorite[]

  // Listings
  listings Listing[] @relation("UserListings")

  // Requests
  bookingRequests BookingRequest[]

  // Contracts
  contractsOwner  Contract[] @relation("ContractsOwner")
  contractsTenant Contract[] @relation("ContractsTenant")

  // Reviews
  reviewsAuthored Review[] @relation("ReviewsAuthored")
  reviewsReceived Review[] @relation("ReviewsReceived")

  // Chat
  chatThreadsOwner  ChatThread[]  @relation("ChatThreadsOwner")
  chatThreadsTenant ChatThread[]  @relation("ChatThreadsTenant")
  chatMessages      ChatMessage[] @relation("ChatMessagesAuthor")
}

model Listing {
  id String @id @default(cuid())

  // Owner
  ownerId String
  owner   User   @relation("UserListings", fields: [ownerId], references: [id], onDelete: Cascade)

  title       String
  description String?
  images      String[] @default([])

  address String?
  city    Json
  price   Int
  area    Float?
  rooms   Int?

  status String @default("ACTIVE")

  buildingType  String?
  rentType      String?
  availableFrom DateTime?

  kitchen   Boolean @default(false)
  pets      Boolean @default(false)
  lift      Boolean @default(false)
  parking   Boolean @default(false)
  furnished Boolean @default(false)
  balcony   Boolean @default(false)
  storage   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites Favorite[]

  // Requests / Contracts
  requests  BookingRequest[]
  contracts Contract[]

  // Chat
  chatThreads ChatThread[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model BookingRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  listingId String
  tenantId  String

  status RequestStatus @default(PENDING)

  message String?
  from    DateTime?
  to      DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenant  User    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([tenantId])
  @@index([listingId, tenantId])
}

model Contract {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  listingId String
  ownerId   String
  tenantId  String

  status ContractStatus @default(DRAFT)

  activeKey String? @unique

  from DateTime?
  to   DateTime?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner   User    @relation("ContractsOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  tenant  User    @relation("ContractsTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  // Reviews
  reviews Review[]

  @@index([listingId])
  @@index([ownerId])
  @@index([tenantId])
}

model Review {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  contractId String
  authorId   String
  targetId   String

  rating  Int
  comment String?

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  author   User     @relation("ReviewsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  target   User     @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([contractId, authorId])
  @@index([targetId, createdAt])
  @@index([authorId, createdAt])
}

model ChatThread {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listingId String
  ownerId   String
  tenantId  String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  owner   User    @relation("ChatThreadsOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  tenant  User    @relation("ChatThreadsTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  @@unique([listingId, tenantId])
  @@index([listingId])
  @@index([ownerId])
  @@index([tenantId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  threadId String
  authorId String
  text     String

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User       @relation("ChatMessagesAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([authorId])
}
